# Copy to .env. Public market data needs no keys.
# Never put real keys in this file.

# How long identical candle requests are reused, in seconds.
# Short on purpose: fresh enough for research, light on public rate limits.
CACHE_TTL_SECONDS=60

# Comma-separated browser origins for the Vite dashboard.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ccxt exchange ids. Public OHLCV only — no API keys and no orders.
CRYPTO_EXCHANGE=binance
CRYPTO_FALLBACK_EXCHANGE=bybit

# Implemented source: yfinance.
# twelvedata is reserved; add a TwelveDataSource before selecting it.
FOREX_SOURCE=yfinance

# Implemented source: yfinance (GC=F gold, SI=F silver).
# twelvedata is reserved for XAU/USD and XAG/USD.
METALS_SOURCE=yfinance

# Read by a future Twelve Data adapter. Not used by yfinance.
TWELVE_DATA_API_KEY=your_twelve_data_api_key
