# Copy to .env. Placeholders only — never put real keys in this file.

# Express listen port.
PORT=5000

# Python analysis service (no /api prefix).
ANALYSIS_URL=http://127.0.0.1:8000

# Research chat (POST /api/agent/chat). Other routes do not read this.
OPENAI_API_KEY=your_openai_api_key

# Optional. Defaults to gpt-4o-mini when unset.
OPENAI_MODEL=gpt-4o-mini

# Secret service role key. Server only. Never copy this into a VITE_ variable.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
